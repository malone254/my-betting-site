/**
 * BETPRO - FULL SYSTEM SCRIPT
 * Handles: Live Odds, Multi-slip Logic, Payouts, and API submission
 */

// 1. STATE MANAGEMENT
let state = {
    selections: JSON.parse(localStorage.getItem('my_betslip')) || [],
    liveGames: [],
    minStake: 50,
    isProcessing: false
};

// 2. INITIALIZE SOCKET (Real-time updates)
const socket = io(); // Connects to the server.js we built

socket.on('odds-update', (newOdds) => {
    state.liveGames = newOdds;
    updateOddsUI(); // Updates numbers on screen without refresh
});

// 3. CORE LOGIC: Handle Selection
function toggleSelection(event) {
    if (state.isProcessing) return;

    const btn = event.currentTarget;
    const matchData = {
        id: btn.dataset.matchId,      // Unique match ID from API
        teams: btn.dataset.matchTeams, // e.g. "Arsenal vs Chelsea"
        market: btn.dataset.market,   // e.g. "Home Win"
        price: parseFloat(btn.dataset.price)
    };

    const betId = `${matchData.id}-${matchData.market}`;
    const existingIndex = state.selections.findIndex(s => s.id === betId);

    if (existingIndex > -1) {
        state.selections.splice(existingIndex, 1);
    } else {
        // Validation: Prevent multiple selections from the same match
        state.selections = state.selections.filter(s => s.id.split('-')[0] !== matchData.id);
        state.selections.push({ ...matchData, id: betId });
    }

    saveAndRender();
}

// 4. CALCULATION & RENDERING
function saveAndRender() {
    localStorage.setItem('my_betslip', JSON.stringify(state.selections));
    
    const slipBody = document.querySelector('.slip-body');
    const badge = document.querySelector('.count');
    const placeBtn = document.querySelector('.place-btn');

    badge.innerText = state.selections.length;

    if (state.selections.length === 0) {
        slipBody.innerHTML = `<div class="empty-state">Select odds to start betting</div>`;
        placeBtn.disabled = true;
        return;
    }

    // Calculate Acca (Accumulator) Odds
    const totalOdds = state.selections.reduce((acc, curr) => acc * curr.price, 1).toFixed(2);

    slipBody.innerHTML = `
        <div class="selection-list">
            ${state.selections.map(item => `
                <div class="item animate-in">
                    <div class="details">
                        <span class="teams">${item.teams}</span>
                        <span class="market">${item.market}</span>
                    </div>
                    <span class="odds">@ ${item.price.toFixed(2)}</span>
                </div>
            `).join('')}
        </div>
        <div class="slip-footer">
            <div class="odds-row">Total Odds: <strong>${totalOdds}</strong></div>
            <input type="number" id="stake" placeholder="Stake (KES)" oninput="calcPayout(${totalOdds})">
            <div id="est-payout">Potential Win: <span>KES 0.00</span></div>
        </div>
    `;

    placeBtn.disabled = false;
    placeBtn.innerText = `PLACE BET (${state.selections.length})`;
}

function calcPayout(odds) {
    const stake = parseFloat(document.getElementById('stake').value) || 0;
    const payout = (stake * odds).toLocaleString();
    document.querySelector('#est-payout span').innerText = `KES ${payout}`;
}

// 5. SUBMIT TO BACKEND (The "Place Bet" Action)
async function submitBet() {
    const stake = parseFloat(document.getElementById('stake').value);

    if (!stake || stake < state.minStake) {
        alert(`Minimum stake is KES ${state.minStake}`);
        return;
    }

    state.isProcessing = true;
    const btn = document.querySelector('.place-btn');
    btn.innerText = "VERIFYING...";

    try {
        const response = await fetch('/api/place-bet', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                selections: state.selections,
                stake: stake,
                totalOdds: state.selections.reduce((acc, curr) => acc * curr.price, 1)
            })
        });

        const result = await response.json();

        if (result.success) {
            alert("Ticket Placed! Reference: " + result.betId);
            state.selections = [];
            saveAndRender();
        }
    } catch (err) {
        alert("Connection Error. Check your internet.");
    } finally {
        state.isProcessing = false;
    }
}

// 6. EVENT LISTENERS
document.addEventListener('DOMContentLoaded', () => {
    // Delegate clicks to match-cards (works even for dynamically loaded games)
    document.addEventListener('click', (e) => {
        if (e.target.closest('.odd-box')) {
            toggleSelection({ currentTarget: e.target.closest('.odd-box') });
        }
    });

    document.querySelector('.place-btn').addEventListener('click', submitBet);
    saveAndRender();
});
