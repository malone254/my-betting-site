// script.js - Professional Betting Site Logic

let selections = [];

// 1. Select DOM Elements
const oddsButtons = document.querySelectorAll('.odd-box');
const betslipContent = document.querySelector('.slip-body');
const betslipCount = document.querySelector('.count');
const placeBetBtn = document.querySelector('.place-btn');

/**
 * Handle selection of odds
 */
function handleSelection(e) {
    const btn = e.currentTarget;
    const matchCard = btn.closest('.match-card');
    const matchName = matchCard.querySelector('.match-teams').innerText;
    const market = btn.querySelector('.odd-label').innerText;
    const price = parseFloat(btn.querySelector('.odd-val').innerText);

    const betId = `${matchName}-${market}`;

    // Check if selection already exists
    const existingIndex = selections.findIndex(s => s.id === betId);

    if (existingIndex > -1) {
        // Remove selection
        selections.splice(existingIndex, 1);
        btn.classList.remove('selected');
        btn.style.background = "#333";
        btn.style.color = "white";
    } else {
        // Add new selection
        selections.push({
            id: betId,
            match: matchName,
            market: market,
            price: price
        });
        btn.classList.add('selected');
        btn.style.background = "var(--primary)";
        btn.style.color = "#000";
    }

    renderBetslip();
}

/**
 * Render the updated UI for the betslip
 */
function renderBetslip() {
    // Update count indicator
    betslipCount.innerText = selections.length;

    if (selections.length === 0) {
        betslipContent.innerHTML = `
            <i class="fas fa-receipt" style="font-size: 30px; margin-bottom: 10px;"></i>
            <p>Click on odds to add bets to your slip.</p>`;
        
        placeBetBtn.disabled = true;
        placeBetBtn.style.background = "#444";
        placeBetBtn.style.cursor = "not-allowed";
        placeBetBtn.innerText = "PLACE BET";
        return;
    }

    // Generate selection HTML
    let selectionsHtml = selections.map(item => `
        <div class="selection-item" style="text-align: left; background: #252525; padding: 12px; margin-bottom: 8px; border-radius: 6px; border-left: 3px solid var(--primary);">
            <div style="font-size: 11px; color: var(--text-dim); text-transform: uppercase;">${item.match}</div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 5px;">
                <span style="font-weight: bold; font-size: 14px;">Result: ${item.market}</span>
                <span style="font-weight: 800; color: var(--primary);">@ ${item.price.toFixed(2)}</span>
            </div>
        </div>
    `).join('');

    // Calculate Total Odds
    const totalOdds = selections.reduce((acc, curr) => acc * curr.price, 1).toFixed(2);

    // Update internal content
    betslipContent.innerHTML = `
        <div class="selections-list" style="max-height: 300px; overflow-y: auto; padding: 10px;">
            ${selectionsHtml}
        </div>
        <div class="slip-summary" style="padding: 15px; background: #1a1a1a; margin-top: 10px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <span>Total Odds:</span>
                <span style="font-weight: bold; color: var(--primary);">${totalOdds}</span>
            </div>
            <input type="number" id="stake-input" placeholder="Enter Stake (KES)" 
                style="width: 100%; padding: 12px; background: #333; border: 1px solid #444; color: white; border-radius: 4px; outline: none; font-weight: bold;">
            <div id="payout-calc" style="margin-top: 10px; font-size: 13px; color: var(--text-dim);">
                Est. Payout: <span style="color: white; font-weight: bold;">KES 0.00</span>
            </div>
        </div>
    `;

    // Enable Place Bet button
    placeBetBtn.disabled = false;
    placeBetBtn.style.background = "var(--primary)";
    placeBetBtn.style.color = "#000";
    placeBetBtn.style.cursor = "pointer";
    placeBetBtn.innerText = `PLACE BET (${selections.length})`;

    // Add Stake Listener for Real-time payout calc
    const stakeInput = document.getElementById('stake-input');
    stakeInput.addEventListener('input', (e) => {
        const stake = parseFloat(e.target.value) || 0;
        const payout = (stake * totalOdds).toLocaleString();
        document.querySelector('#payout-calc span').innerText = `KES ${payout}`;
    });
}

/**
 * Submit bet simulation
 */
placeBetBtn.addEventListener('click', () => {
    const stake = document.getElementById('stake-input').value;
    
    if (!stake || stake < 50) {
        alert("Minimum stake is KES 50");
        return;
    }

    // Simulation of API Call
    placeBetBtn.innerText = "PROCESSING...";
    placeBetBtn.disabled = true;

    setTimeout(() => {
        alert(`Success! Your bet on ${selections.length} events has been placed.\nStake: KES ${stake}`);
        
        // Reset slip
        selections = [];
        document.querySelectorAll('.odd-box').forEach(b => {
            b.style.background = "#333";
            b.style.color = "white";
        });
        renderBetslip();
    }, 1500);
});

// Initial Event Listeners
oddsButtons.forEach(btn => btn.addEventListener('click', handleSelection));
